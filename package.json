  "exports": { ".": { "types": "./index.d.ts", "default": "./src/index.js" }, "./fx/*": { "types": "./fx.d.ts", "default": "./src/fx/*.js" } },
  "files": ["src", "index.d.ts", "fx.d.ts", "NOTICE.md"],
  "peerDependencies": { "three": ">=0.160.0" },
  "devDependencies": { "three": "0.170.0", "playwright": "*" },
  "license": "MIT"
}
