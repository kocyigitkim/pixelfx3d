{
  "name": "pixelfx3d",
  "version": "0.1.0",
  "description": "Realistic 3D, shader-driven VFX library for three.js (WebGL2). 3D reimagining of patch-gg/pixelfx.",
  "type": "module",
  "main": "src/index.js",
